rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Limitless+ access. Readable by its owner, never writable from the app — only trusted
    // server code (payment webhooks, clinic code redemption) using the Admin SDK can grant it,
    // so nobody can make themselves premium by writing to their own profile.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    // Daily reminder settings (hour, time zone, push subscription). Same idea: shown to its
    // owner, written only by /api/reminders, which checks the push address is a real one.
    match /reminders/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    // accessCodes/{code} (clinic codes and their redemptions) has no rule on purpose:
    // the default deny keeps codes unguessable from the app; only /api/redeem-code reads them.
  }
}
